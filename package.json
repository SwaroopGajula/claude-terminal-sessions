{
  "name": "claude-terminal-sessions",
  "displayName": "Claude Terminal Sessions",
  "description": "Claude Code session manager: every terminal session from every folder in one sidebar. Search inside conversations, see running agents, token usage and cost, resume, fork, pin, label, archive, share, follow-up reminders and daily summaries.",
  "version": "0.10.0",
  "publisher": "SwaroopGajula",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SwaroopGajula/claude-terminal-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/SwaroopGajula/claude-terminal-sessions/issues"
  },
  "homepage": "https://github.com/SwaroopGajula/claude-terminal-sessions#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2A2724",
    "theme": "dark"
  },
  "keywords": [
    "claude",
    "claude code",
    "claude-code",
    "anthropic",
    "ai",
    "session manager",
    "sessions",
    "history",
    "conversation history",
    "resume",
    "terminal",
    "cli",
    "agent",
    "productivity",
    "cursor",
    "token usage",
    "cost"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "lint": "node --check extension.js && node --check share.js && node --check running.js && node --check followups.js && node --check summary.js && node --check marks.js && node --check search.js && node --check paths.js && node --check usage.js && node --check shell.js && node --check agents.js && node --check notify.js",
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce@4.1.0 package"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSessions",
          "title": "Claude Terminal Sessions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeSessions": [
        {
          "id": "claudeSessions.list",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSessions.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSessions.search",
        "title": "Filter Sessions",
        "icon": "$(search)"
      },
      {
        "command": "claudeSessions.clearFilter",
        "title": "Clear Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeSessions.toggleGroup",
        "title": "Toggle Group By Date / Folder",
        "icon": "$(list-tree)"
      },
      {
        "command": "claudeSessions.resume",
        "title": "Resume in Terminal",
        "icon": "$(play)"
      },
      {
        "command": "claudeSessions.copyId",
        "title": "Copy Session ID",
        "icon": "$(copy)"
      },
      {
        "command": "claudeSessions.copyCommand",
        "title": "Copy Resume Command"
      },
      {
        "command": "claudeSessions.openFolder",
        "title": "Open Folder in New Window",
        "icon": "$(folder-opened)"
      },
      {
        "command": "claudeSessions.openTranscript",
        "title": "Open Raw Transcript (.jsonl)"
      },
      {
        "command": "claudeSessions.openConversation",
        "title": "Open Conversation",
        "icon": "$(book)"
      },
      {
        "command": "claudeSessions.copyShellCommand",
        "title": "Copy Command",
        "icon": "$(copy)"
      },
      {
        "command": "claudeSessions.runShellCommand",
        "title": "Paste Command into Terminal (not run)",
        "icon": "$(terminal)"
      },
      {
        "command": "claudeSessions.exportMarkdown",
        "title": "Share: Export for Reading (.md)",
        "icon": "$(markdown)"
      },
      {
        "command": "claudeSessions.exportSession",
        "title": "Share: Export to Continue on Another Computer",
        "icon": "$(export)"
      },
      {
        "command": "claudeSessions.importSession",
        "title": "Import Shared Session\u2026",
        "icon": "$(desktop-download)"
      },
      {
        "command": "claudeSessions.dailySummary",
        "title": "Daily Summary of Claude Work",
        "icon": "$(calendar)"
      },
      {
        "command": "claudeSessions.fork",
        "title": "Fork Session (new copy of the conversation)",
        "icon": "$(repo-forked)"
      },
      {
        "command": "claudeSessions.setFollowup",
        "title": "Set Follow-up Reminder\u2026",
        "icon": "$(bell)"
      },
      {
        "command": "claudeSessions.clearFollowup",
        "title": "Clear Follow-up"
      },
      {
        "command": "claudeSessions.showDue",
        "title": "Claude Sessions: Show What Needs Attention"
      },
      {
        "command": "claudeSessions.searchConversations",
        "title": "Search Inside Conversations\u2026",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "claudeSessions.pin",
        "title": "Pin to Top",
        "icon": "$(pin)"
      },
      {
        "command": "claudeSessions.unpin",
        "title": "Unpin",
        "icon": "$(pinned)"
      },
      {
        "command": "claudeSessions.editNote",
        "title": "Edit Note\u2026",
        "icon": "$(note)"
      },
      {
        "command": "claudeSessions.setLabels",
        "title": "Set Labels\u2026",
        "icon": "$(tag)"
      },
      {
        "command": "claudeSessions.filterByLabel",
        "title": "Filter by Label\u2026",
        "icon": "$(tag)"
      },
      {
        "command": "claudeSessions.archive",
        "title": "Archive (hide from list)",
        "icon": "$(archive)"
      },
      {
        "command": "claudeSessions.unarchive",
        "title": "Unarchive"
      },
      {
        "command": "claudeSessions.showArchived",
        "title": "Show Archived Sessions",
        "icon": "$(eye)"
      },
      {
        "command": "claudeSessions.hideArchived",
        "title": "Hide Archived Sessions",
        "icon": "$(eye-closed)"
      },
      {
        "command": "claudeSessions.delete",
        "title": "Delete Session (move to Trash)\u2026",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSessions.usageReport",
        "title": "Token Usage and Cost Report",
        "icon": "$(graph)"
      },
      {
        "command": "claudeSessions.rename",
        "title": "Rename\u2026",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSessions.openAgent",
        "title": "Open Agent Conversation",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeSessions.search",
          "when": "view == claudeSessions.list",
          "group": "navigation@1"
        },
        {
          "command": "claudeSessions.toggleGroup",
          "when": "view == claudeSessions.list",
          "group": "navigation@2"
        },
        {
          "command": "claudeSessions.refresh",
          "when": "view == claudeSessions.list",
          "group": "navigation@3"
        },
        {
          "command": "claudeSessions.clearFilter",
          "when": "view == claudeSessions.list && claudeSessions.filtered",
          "group": "navigation@0"
        },
        {
          "command": "claudeSessions.importSession",
          "when": "view == claudeSessions.list",
          "group": "navigation@2.5"
        },
        {
          "command": "claudeSessions.dailySummary",
          "when": "view == claudeSessions.list",
          "group": "navigation@0.5"
        },
        {
          "command": "claudeSessions.searchConversations",
          "when": "view == claudeSessions.list",
          "group": "navigation@1.5"
        },
        {
          "command": "claudeSessions.filterByLabel",
          "when": "view == claudeSessions.list",
          "group": "1_filter@1"
        },
        {
          "command": "claudeSessions.showArchived",
          "when": "view == claudeSessions.list && !claudeSessions.showArchived",
          "group": "1_filter@2"
        },
        {
          "command": "claudeSessions.hideArchived",
          "when": "view == claudeSessions.list && claudeSessions.showArchived",
          "group": "1_filter@2"
        },
        {
          "command": "claudeSessions.usageReport",
          "when": "view == claudeSessions.list",
          "group": "navigation@0.6"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSessions.resume",
          "when": "viewItem =~ /^session( |$)/",
          "group": "inline@1"
        },
        {
          "command": "claudeSessions.openConversation",
          "when": "viewItem =~ /^session( |$)/",
          "group": "inline@1.5"
        },
        {
          "command": "claudeSessions.copyId",
          "when": "viewItem =~ /^session( |$)/",
          "group": "inline@2"
        },
        {
          "command": "claudeSessions.resume",
          "when": "viewItem =~ /^session( |$)/",
          "group": "1_main@1"
        },
        {
          "command": "claudeSessions.copyId",
          "when": "viewItem =~ /^session( |$)/",
          "group": "1_main@2"
        },
        {
          "command": "claudeSessions.copyCommand",
          "when": "viewItem =~ /^session( |$)/",
          "group": "1_main@3"
        },
        {
          "command": "claudeSessions.openFolder",
          "when": "viewItem =~ /^session( |$)/",
          "group": "2_open@1"
        },
        {
          "command": "claudeSessions.openTranscript",
          "when": "viewItem =~ /^session( |$)/",
          "group": "2_open@2"
        },
        {
          "command": "claudeSessions.openConversation",
          "when": "viewItem =~ /^session( |$)/",
          "group": "1_main@1.5"
        },
        {
          "command": "claudeSessions.copyShellCommand",
          "when": "viewItem == sessionCommand",
          "group": "inline@1"
        },
        {
          "command": "claudeSessions.copyShellCommand",
          "when": "viewItem == sessionCommand",
          "group": "1_main@1"
        },
        {
          "command": "claudeSessions.runShellCommand",
          "when": "viewItem == sessionCommand",
          "group": "1_main@2"
        },
        {
          "command": "claudeSessions.exportMarkdown",
          "when": "viewItem =~ /^session( |$)/",
          "group": "3_share@1"
        },
        {
          "command": "claudeSessions.exportSession",
          "when": "viewItem =~ /^session( |$)/",
          "group": "3_share@2"
        },
        {
          "command": "claudeSessions.fork",
          "when": "viewItem =~ /^session( |$)/",
          "group": "1_main@1.2"
        },
        {
          "command": "claudeSessions.setFollowup",
          "when": "viewItem =~ /^session( |$)/",
          "group": "4_followup@1"
        },
        {
          "command": "claudeSessions.clearFollowup",
          "when": "viewItem =~ /^session .*\\bfu\\b/",
          "group": "4_followup@2"
        },
        {
          "command": "claudeSessions.pin",
          "when": "viewItem =~ /^session( |$)/ && viewItem =~ /^(?!.*\\bpinned\\b)/",
          "group": "5_organize@1"
        },
        {
          "command": "claudeSessions.unpin",
          "when": "viewItem =~ /^session .*\\bpinned\\b/",
          "group": "5_organize@1"
        },
        {
          "command": "claudeSessions.editNote",
          "when": "viewItem =~ /^session( |$)/",
          "group": "5_organize@2"
        },
        {
          "command": "claudeSessions.setLabels",
          "when": "viewItem =~ /^session( |$)/",
          "group": "5_organize@3"
        },
        {
          "command": "claudeSessions.archive",
          "when": "viewItem =~ /^session( |$)/ && viewItem =~ /^(?!.*\\barchived\\b)/",
          "group": "6_archive@1"
        },
        {
          "command": "claudeSessions.unarchive",
          "when": "viewItem =~ /^session .*\\barchived\\b/",
          "group": "6_archive@1"
        },
        {
          "command": "claudeSessions.delete",
          "when": "viewItem =~ /^session( |$)/",
          "group": "6_archive@2"
        },
        {
          "command": "claudeSessions.rename",
          "when": "viewItem =~ /^session( |$)/",
          "group": "5_organize@0"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeSessions.resume",
          "when": "false"
        },
        {
          "command": "claudeSessions.copyId",
          "when": "false"
        },
        {
          "command": "claudeSessions.copyCommand",
          "when": "false"
        },
        {
          "command": "claudeSessions.openFolder",
          "when": "false"
        },
        {
          "command": "claudeSessions.openTranscript",
          "when": "false"
        },
        {
          "command": "claudeSessions.openConversation",
          "when": "false"
        },
        {
          "command": "claudeSessions.copyShellCommand",
          "when": "false"
        },
        {
          "command": "claudeSessions.runShellCommand",
          "when": "false"
        },
        {
          "command": "claudeSessions.exportMarkdown",
          "when": "false"
        },
        {
          "command": "claudeSessions.exportSession",
          "when": "false"
        },
        {
          "command": "claudeSessions.fork",
          "when": "false"
        },
        {
          "command": "claudeSessions.setFollowup",
          "when": "false"
        },
        {
          "command": "claudeSessions.clearFollowup",
          "when": "false"
        },
        {
          "command": "claudeSessions.pin",
          "when": "false"
        },
        {
          "command": "claudeSessions.unpin",
          "when": "false"
        },
        {
          "command": "claudeSessions.editNote",
          "when": "false"
        },
        {
          "command": "claudeSessions.setLabels",
          "when": "false"
        },
        {
          "command": "claudeSessions.archive",
          "when": "false"
        },
        {
          "command": "claudeSessions.unarchive",
          "when": "false"
        },
        {
          "command": "claudeSessions.delete",
          "when": "false"
        },
        {
          "command": "claudeSessions.rename",
          "when": "false"
        },
        {
          "command": "claudeSessions.openAgent",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Claude Terminal Sessions",
      "properties": {
        "claudeSessions.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to launch Claude Code."
        },
        "claudeSessions.groupBy": {
          "type": "string",
          "enum": [
            "date",
            "folder"
          ],
          "default": "date",
          "description": "How sessions are grouped in the sidebar."
        },
        "claudeSessions.maxSessions": {
          "type": "number",
          "default": 300,
          "description": "Maximum number of sessions to show (most recent first)."
        },
        "claudeSessions.autoArchiveDays": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Automatically archive (hide) sessions not used for this many days. Pinned sessions and sessions with a follow-up are never auto-archived. 0 turns this off."
        },
        "claudeSessions.showCost": {
          "type": "boolean",
          "default": true,
          "description": "Show the estimated cost of each session (at Anthropic API list prices) on its row, in its details and in the daily summary. Token counts are always shown."
        },
        "claudeSessions.modelPricing": {
          "type": "object",
          "default": {},
          "markdownDescription": "Override or add model prices in US$ per million tokens, e.g. `{\"claude-opus-5-5\": {\"input\": 4, \"output\": 20, \"cacheRead\": 0.2, \"cacheWrite5m\": 5, \"cacheWrite1h\": 8}}`. Fields you leave out keep the built-in price.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cacheRead": {
                "type": "number",
                "minimum": 0
              },
              "cacheWrite5m": {
                "type": "number",
                "minimum": 0
              },
              "cacheWrite1h": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "claudeSessions.notifyNeedsInput": {
          "type": "boolean",
          "default": true,
          "description": "Show an alert when a Claude Code session starts waiting for your input (for example a permission question). Skipped when you are already looking at that session's terminal."
        },
        "claudeSessions.notifyAgentDone": {
          "type": "boolean",
          "default": true,
          "description": "Show an alert when an agent started by a running Claude Code session finishes."
        }
      }
    },
    "keybindings": [
      {
        "command": "claudeSessions.rename",
        "key": "f2",
        "when": "focusedView == claudeSessions.list"
      }
    ]
  }
}
